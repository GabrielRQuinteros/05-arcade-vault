# Copiar a .env.local y completar. Nunca commitear .env.local.

# API key de Resend: https://resend.com/api-keys
RESEND_API_KEY=

# Destinatario de los mensajes de contacto.
# Sin dominio verificado en Resend, debe ser el correo dueño de la cuenta.
CONTACT_TO_EMAIL=

# Supabase: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Password de la BD. Solo para Supabase CLI / migraciones; la app no la lee.
SUPABASE_DB_PASSWORD=

# Better Auth: https://www.better-auth.com/docs/installation
# Secreto de firma (>= 32 chars). Generar con: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# URL base de la app (http://localhost:3000 en dev).
BETTER_AUTH_URL=

# Connection string Postgres de Supabase (Dashboard > Connect > Transaction pooler, puerto 6543).
# Contiene la password de la BD. Solo servidor.
DATABASE_URL=

# Google OAuth: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth: https://github.com/settings/developers > New OAuth App
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
